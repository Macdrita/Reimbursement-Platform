// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  HOD
  FINANCE
  FINANCE_ADMIN
  SUPERADMIN
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  BLACKLISTED
}

enum PayoutBatchStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  budget      Float    @default(0.0)
  hodId       String?
  hod         User?    @relation("DepartmentHod", fields: [hodId], references: [id])
  createdAt   DateTime @default(now())
}

model PolicyRule {
  id             String  @id @default(uuid())
  category       String  @unique
  maxLimit       Float
  requireReceipt Boolean @default(false)
  requireGstin   Boolean @default(false)
}

model PayoutBatch {
  id           String            @id @default(uuid())
  status       PayoutBatchStatus @default(DRAFT)
  totalAmount  Float
  executedById String
  executedBy   User              @relation(fields: [executedById], references: [id])
  claims       Claim[]
  createdAt    DateTime          @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  metadata  Json
  ipAddress String?
  createdAt DateTime @default(now())
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(EMPLOYEE)
  registrationStatus RegistrationStatus @default(APPROVED)
  
  // Hierarchical approval relationship (Self-referencing manager relation)
  managerId String?
  manager   User?    @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates User[] @relation("ManagerSubordinates")

  claimsSubmitted Claim[] @relation("SubmittedClaims")
  claimsReviewed  Claim[] @relation("ReviewedClaims")
  claimsRedirectedTo Claim[] @relation("RedirectedClaims")
  ledDepartments Department[] @relation("DepartmentHod")
  payoutBatches  PayoutBatch[]
  auditLogs      AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Claim {
  id            String      @id @default(uuid())
  title         String
  description   String?
  amount        Float
  receiptUrl    String
  status        ClaimStatus @default(PENDING)
  
  employeeId    String
  employee      User        @relation("SubmittedClaims", fields: [employeeId], references: [id])

  reviewerId    String?
  reviewer      User?       @relation("ReviewedClaims", fields: [reviewerId], references: [id])

  isRedirected   Boolean     @default(false)
  redirectedToId String?
  redirectedTo   User?       @relation("RedirectedClaims", fields: [redirectedToId], references: [id])
  redirectReason String?

  payoutBatchId String?
  payoutBatch   PayoutBatch? @relation(fields: [payoutBatchId], references: [id])
  isFlagged     Boolean      @default(false)

  reviewComment String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
